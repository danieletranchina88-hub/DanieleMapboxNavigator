<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DanieleNavigator" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nav_blue</item>
        <item name="colorSecondary">@color/nav_blue_dark</item>
        <item name="colorError">@color/nav_red</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nav_black</item>
        <item name="android:navigationBarColor">@color/nav_black</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.DanieleNavigator.SheetOption" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/sheet_option_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="strokeColor">@color/sheet_option_stroke</item>
        <item name="backgroundTint">@color/sheet_option_background</item>
        <item name="cornerRadius">14dp</item>
        <item name="rippleColor">@color/nav_blue</item>
    </style>
</resources>

